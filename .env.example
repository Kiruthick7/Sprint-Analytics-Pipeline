# Copy to .env and fill in values. See README "How to run" for steps.
# Recent optimizations: Confluence API v2, consolidated caching, ~140 lines of duplication eliminated

# Jira Configuration (required)
JIRA_USER_NAME=your.email@company.com
JIRA_TOKEN=your_jira_api_token
JIRA_SERVER=https://your-org.atlassian.net

# Story points custom field (auto-detected from board config; leave unset for auto-detection)
# JIRA_STORY_POINTS_FIELD=customfield_10016

# Microsoft Teams Webhook (required for notifications)
TEAMS_WEBHOOK=https://outlook.office.com/webhook/xxx-teams-webhook

# LLM Configuration (required for Blockers comment summaries)
# groq = Groq llama-4-scout-17b (fast, free tier 30K TPM)
# gemini = Google AI Studio gemini-1.5-flash (1M context, free tier)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

# Alternative: use Gemini (large context; same API as Vertex AI)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_google_ai_studio_key

# Confluence (report page) - Uses REST API v2 with automatic space key → space ID conversion
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USER=your.email@company.com
CONFLUENCE_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=YOUR_SPACE

# Optional: Link to external velocity dashboard (appears in Confluence report)
VELOCITY_DASHBOARD_URL=https://your-velocity-dashboard-url

# Public URL of this app (used for "Developer Lookup" link on Confluence report page)
# Set after first deploy, then redeploy to update function with this URL
# e.g. https://your-project.cloudfunctions.net/jira-daily-report (no trailing slash)
# APP_BASE_URL=https://your-app-url

# Google Cloud Configuration (for deploy.sh)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
CLOUD_FUNCTION_NAME=jira-daily-report

# Cloud Scheduler (optional; defaults: daily Mon-Sat 7 AM IST)
# SCHEDULE_CRON="30 1 * * 1-6"   # 1=Mon, 6=Sat (0=Sun, 1=Mon, 2=Tue, ... 6=Sat)
# SCHEDULE_TIMEZONE=Asia/Kolkata
