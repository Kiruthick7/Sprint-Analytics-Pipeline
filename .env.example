# Jira Configuration
JIRA_USER_NAME=your.email@company.com
JIRA_TOKEN=your_jira_api_token


# Microsoft Teams Webhook
TEAMS_WEBHOOK=https://outlook.office.com/webhook/xxx-teams-webhook

# LLM (free tier for testing). Later: use Vertex AI / Gemini on GCP.
# groq = Groq llama-4-scout-17b (30K TPM). gemini = Google AI Studio gemini-1.5-flash (1M context).
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

# Optional: use Gemini (free, large context; same API as Vertex AI later)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_google_ai_studio_key

# Confluence (report page)
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USER=your.email@company.com
CONFLUENCE_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=YOUR_SPACE

# Google Cloud Configuration (for deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
CLOUD_FUNCTION_NAME=jira-daily-report
SERVICE_ACCOUNT_EMAIL=jira-reporter@your-project.iam.gserviceaccount.com
